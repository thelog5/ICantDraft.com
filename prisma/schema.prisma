generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  YAHOO
  ESPN
}

enum Sport {
  NBA
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrationAccounts IntegrationAccount[]
  leagues             League[]             @relation("LeagueCommissioner")
}

model IntegrationAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  provider  Provider
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerAccountId String

  accessToken  String?
  refreshToken String?
  tokenType    String?
  scope        String?
  expiresAt    DateTime?

  meta Json? @db.JsonB

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model DemoSnapshot {
  id        String   @id // e.g. "demo_v1"
  label     String
  createdAt DateTime @default(now())
  
  sourceLeagueId String?

  leagues     League[]
  teams       Team[]
  players     Player[]
  rosterSlots RosterSlot[]
}

model League {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider
  sport    Sport    @default(NBA)

  providerLeagueId String
  name             String
  seasonYear       Int

  commissionerUserId String? @db.Uuid
  settings           Json?   @db.JsonB

  demoSnapshotId String?

  commissionerUser User?          @relation("LeagueCommissioner", fields: [commissionerUserId], references: [id], onDelete: SetNull)
  demoSnapshot     DemoSnapshot?  @relation(fields: [demoSnapshotId], references: [id], onDelete: Cascade)

  teams       Team[]
  players     Player[]     @relation("LeaguePlayers")
  rosterSlots RosterSlot[]

  @@unique([provider, providerLeagueId, seasonYear])
  @@index([commissionerUserId])
  @@index([demoSnapshotId])
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  leagueId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider       Provider
  providerTeamId String

  name        String
  managerName String?
  meta        Json?   @db.JsonB

  demoSnapshotId String?

  league       League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  demoSnapshot DemoSnapshot? @relation(fields: [demoSnapshotId], references: [id], onDelete: Cascade)
  rosterSlots  RosterSlot[]

  @@unique([leagueId, provider, providerTeamId])
  @@index([leagueId])
  @@index([demoSnapshotId])
}

model Player {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider         Provider
  providerPlayerId String

  fullName    String
  firstName   String?
  lastName    String?
  nbaTeamAbbr String?
  positions   String[]
  isActive    Boolean  @default(true)

  meta Json? @db.JsonB

  demoSnapshotId String?

  leagues      League[]      @relation("LeaguePlayers")
  rosterSlots  RosterSlot[]
  demoSnapshot DemoSnapshot? @relation(fields: [demoSnapshotId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPlayerId])
  @@index([fullName])
  @@index([demoSnapshotId])
}

model RosterSlot {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leagueId String @db.Uuid
  teamId   String @db.Uuid
  playerId String @db.Uuid

  providerRosterSlotId String?

  startAt DateTime
  endAt   DateTime?

  slotLabel String?
  meta      Json?   @db.JsonB

  demoSnapshotId String?

  league       League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  demoSnapshot DemoSnapshot? @relation(fields: [demoSnapshotId], references: [id], onDelete: Cascade)

  @@index([leagueId, teamId, startAt])
  @@index([playerId, startAt])
  @@index([demoSnapshotId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime

  mode              String  // "espn" or "demo"
  leagueId          String?
  seasonId          Int?
  teamId            String? // internal team id
  providerTeamId    String? // ESPN team id
  encryptedCredentials String? // AES-encrypted ESPN_S2:SWID for espn mode

  @@index([expiresAt])
}
